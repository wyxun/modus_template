NUMERIC ?= FLOAT
IDENTIFY ?= 0
MFOC_ROOT := mfoc
include $(MFOC_ROOT)/mfoc.mk

CPPFLAGS += -DMFOC_NUMERIC_$(NUMERIC)=1 -DMFOC_IDENTIFICATION_ENABLE=$(IDENTIFY)
CPPFLAGS += -DMFOC_FEEDBACK_BACKEND=MFOC_FEEDBACK_POSITION
CFLAGS += -std=c11 -O2 -Wall -Wextra -Werror -ffp-contract=off

consumer-$(NUMERIC)-$(IDENTIFY).exe: consumer.c $(MFOC_SOURCES)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(MFOC_INCLUDES) $^ -lm -o $@
